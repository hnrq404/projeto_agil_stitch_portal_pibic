{
  "name": "portal-pibic-server",
  "version": "1.0.0",
  "private": true,
  "description": "API do Portal de Gestão de Laboratório — Sprint 2: Edital & Publicação (M2) + Auth",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "prisma db push --schema src/infra/prisma/schema.prisma",
    "db:generate": "prisma generate --schema src/infra/prisma/schema.prisma",
    "db:studio": "prisma studio --schema src/infra/prisma/schema.prisma",
    "db:seed": "tsx src/infra/seed.ts",
    "test": "jest --selectProjects unit integration --runInBand",
    "test:unit": "jest --selectProjects unit --runInBand",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:e2e": "jest --selectProjects e2e --runInBand"
  },
  "prisma": {
    "schema": "src/infra/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "5.16.1",
    "bcryptjs": "2.4.3",
    "express": "4.19.2",
    "jsonwebtoken": "9.0.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.14.9",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "prisma": "5.16.1",
    "supertest": "7.0.0",
    "ts-jest": "29.1.5",
    "tsx": "4.15.7",
    "typescript": "5.5.3"
  }
}
