{
  "name": "portal-pibic-server",
  "version": "1.0.0",
  "private": true,
  "description": "API do Portal PIBIC: Express + Firestore, pronta para a Vercel (editais, inscrições, triagem, homologação, relatórios)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "emulador": "firebase emulators:start --only firestore --project demo-portal-pibic",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "serve": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "db:seed": "tsx src/infra/seed.ts",
    "test": "jest --selectProjects unit integration --runInBand",
    "test:unit": "jest --selectProjects unit --runInBand",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:integration:firestore": "firebase emulators:exec --only firestore --project demo-portal-pibic \"cross-env TEST_PERSISTENCIA=firestore jest --selectProjects integration --runInBand\"",
    "test:e2e": "firebase emulators:exec --only firestore --project demo-portal-pibic \"jest --selectProjects e2e --runInBand\"",
    "e2e:ui": "firebase emulators:exec --only firestore --project demo-portal-pibic \"npm run test:e2e --prefix ../web\""
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "2.4.3",
    "express": "4.22.3",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "9.0.2",
    "nodemailer": "^10.2.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.14.9",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "6.0.2",
    "cross-env": "7.0.3",
    "eslint": "10.12.0",
    "firebase-tools": "^15.34.1",
    "globals": "17.13.0",
    "jest": "29.7.0",
    "prettier": "3.9.9",
    "supertest": "7.0.0",
    "ts-jest": "29.1.5",
    "tsc-alias": "1.8.10",
    "tsx": "4.15.7",
    "typescript": "5.5.3",
    "typescript-eslint": "8.71.0"
  },
  "engines": {
    "node": ">=22"
  }
}
