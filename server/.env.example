# Copie para server/.env e ajuste. O arquivo .env não é versionado.

# ── Banco: Firestore ─────────────────────────────────────────────────────────
# Desenvolvimento local: emulador (npm run emulador, exige Java 21+). Os dados
# somem quando o emulador fecha; rode npm run db:seed depois de subir.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_PROJECT_ID=demo-portal-pibic

# Projeto real a partir da sua máquina (ex.: demonstração): sem FIRESTORE_EMULATOR_HOST,
# aponte para o JSON da conta de serviço guardado FORA do repositório.
# FIREBASE_PROJECT_ID=seu-projeto
# GOOGLE_APPLICATION_CREDENTIALS=C:/Users/voce/chaves/seu-projeto-admin.json

# Produção (Vercel): NÃO defina FIRESTORE_EMULATOR_HOST. Use a conta de serviço
# do projeto (Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada).
# FIREBASE_PROJECT_ID=seu-projeto
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Autenticação ─────────────────────────────────────────────────────────────
# Obrigatório com NODE_ENV=production: valor aleatório com 32+ caracteres (openssl rand -base64 48).
JWT_SECRET="troque-em-producao"
PORT=3000

# ── PDFs ─────────────────────────────────────────────────────────────────────
# Com BLOB_READ_WRITE_TOKEN, vão para o Vercel Blob (privado). Sem ele, para esta
# pasta (relativa a server/), servidos pela própria API com links assinados.
UPLOADS_DIR="uploads"
# BLOB_READ_WRITE_TOKEN=

# ── Vercel ───────────────────────────────────────────────────────────────────
# Segredo que a Vercel Cron envia ao chamar /api/cron/... (valor aleatório).
# CRON_SECRET=
# Atrás de proxy reverso fora da Vercel: número de proxies confiáveis (na Vercel já é automático).
# TRUST_PROXY=1

# Sobe a API sem banco nenhum (dados em memória, somem ao reiniciar).
# PERSISTENCIA=memoria
