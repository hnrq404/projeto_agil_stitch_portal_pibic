# Copie para server/.env e ajuste. O arquivo .env não é versionado.
DATABASE_URL="file:./dev.db"
# Obrigatório com NODE_ENV=production: valor aleatório com 32+ caracteres (openssl rand -base64 48).
JWT_SECRET="troque-em-producao"
PORT=3000
# Pasta dos PDFs enviados (relativa a server/).
UPLOADS_DIR="uploads"
# USE_PRISMA=false
# Atrás de proxy reverso (nginx, Render...): número de proxies confiáveis, para o
# rate limit enxergar o IP real do usuário via X-Forwarded-For.
# TRUST_PROXY=1
