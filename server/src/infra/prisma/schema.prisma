// Schema Prisma — persistência REAL da aplicação (SQLite, zero-config).
// Para PostgreSQL: troque provider para "postgresql" e aponte DATABASE_URL.
//
//   npx prisma generate --schema src/infra/prisma/schema.prisma
//   npx prisma db push   --schema src/infra/prisma/schema.prisma
//
// Nota: SQLite não suporta enums do Prisma — status/roles são String validados
// na camada de domínio (mesma regra do núcleo hexagonal).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  /// "DISCENTE" | "DOCENTE" | "GESTOR" | "ADMIN" | "USUARIO" — validado na camada de domínio.
  /// O docente também avalia projetos de outros professores (não há papel de avaliador separado).
  role         String
  /// Departamento/unidade.
  departamento String   @default("")
  /// Matrícula (discentes) — mascarada em exportações (RN09).
  matricula    String?
  criadoEm     DateTime @default(now())

  notificacoes Notificacao[]
}

model Edital {
  id                   String   @id @default(uuid())
  numero               String   @unique
  titulo               String
  descricao            String   @default("")
  /// "RASCUNHO" | "PUBLICADO" | "ENCERRADO"
  status               String   @default("RASCUNHO")
  /// "PIBIC" | "PIBITI" | "PIBIC_AF" | "VOLUNTARIO"
  tipoBolsa            String
  totalCotas           Int
  /// Nota mínima (0–10); abaixo dela o parecer é obrigatório (RN07).
  notaCorte            Float    @default(6)
  dataInicioInscricoes DateTime
  dataFimInscricoes    DateTime
  publicadoEm          DateTime?
  encerradoEm          DateTime?
  criadoEm             DateTime @default(now())
  atualizadoEm         DateTime @updatedAt

  cotas      CotaSubarea[]
  inscricoes Inscricao[]

  @@index([status, dataFimInscricoes])
}

model CotaSubarea {
  id          String @id @default(uuid())
  editalId    String
  edital      Edital @relation(fields: [editalId], references: [id], onDelete: Cascade)
  subareaCode String
  subareaNome String
  quantidade  Int

  @@unique([editalId, subareaCode])
  @@index([subareaCode])
}

model Notificacao {
  id          String   @id @default(uuid())
  userId      String
  user        Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// NotificacaoTipo (modules/notificacoes/domain/notificacoes.types.ts)
  tipo        String
  titulo      String
  mensagem    String
  referenceId String?
  lida        Boolean  @default(false)
  criadoEm    DateTime @default(now())

  @@index([userId, lida])
  @@index([userId, criadoEm])
  @@index([referenceId, tipo])
}

model Inscricao {
  id                       String    @id
  protocolo                String?   @unique
  editalId                 String
  edital                   Edital    @relation(fields: [editalId], references: [id], onDelete: Restrict)
  /// Aluno selecionado pelo professor entre os candidatos (nulo até a seleção).
  discenteId               String?
  /// Professor dono do projeto de pesquisa (anulável só por compatibilidade com dados antigos).
  orientadorId             String?
  titulo                   String    @default("")
  subareaCode              String    @default("")
  subareaNome              String    @default("")
  palavrasChave            String    @default("")
  resumo                   String    @default("")
  objetivos                String    @default("")
  metodologia              String    @default("")
  /// "RASCUNHO" | "DIVULGADA" | "EM_AVALIACAO" | "AVALIADA" | "APROVADA" | "RECUSADA"
  status                   String    @default("RASCUNHO")
  homologacaoJustificativa String?
  divulgadaEm              DateTime?
  submetidaEm              DateTime?
  homologadaEm             DateTime?
  criadoEm                 DateTime
  atualizadoEm             DateTime

  anexos       Anexo[]
  avaliacoes   Avaliacao[]
  relatorios   Relatorio[]
  candidaturas Candidatura[]

  @@unique([editalId, discenteId])
  @@index([status])
  @@index([orientadorId])
  @@index([discenteId])
  @@index([editalId, subareaCode, status])
}

/// Candidatura do aluno a um projeto de pesquisa divulgado pelo professor.
model Candidatura {
  id           String    @id
  inscricaoId  String
  inscricao    Inscricao @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)
  discenteId   String
  /// Por que o aluno quer participar do projeto.
  mensagem     String
  /// "PENDENTE" | "SELECIONADA" | "NAO_SELECIONADA"
  status       String
  criadoEm     DateTime
  respondidaEm DateTime?

  @@unique([inscricaoId, discenteId])
  @@index([discenteId])
}

/// Último sequencial de protocolo emitido no ano — incrementado atomicamente na submissão.
model SequenciaProtocolo {
  ano    Int @id
  ultimo Int
}

model Anexo {
  id          String    @id
  inscricaoId String
  inscricao   Inscricao @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)
  /// "PLANO_TRABALHO" | "LATTES"
  tipo        String
  storageKey  String
  nome        String
  tamanho     Int
  mimeType    String
  enviadoEm   DateTime

  @@unique([inscricaoId, tipo])
}

model Avaliacao {
  id          String    @id
  inscricaoId String
  inscricao   Inscricao @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)
  avaliadorId String
  /// "PENDENTE" | "CONCLUIDA"
  status      String
  /// JSON: [{ criterio, nota }]
  notas       String    @default("[]")
  notaFinal   Float?
  parecer     String    @default("")
  atribuidaEm DateTime
  concluidaEm DateTime?

  @@unique([inscricaoId, avaliadorId])
  @@index([avaliadorId, status])
}

model Relatorio {
  id                   String    @id
  inscricaoId          String
  inscricao            Inscricao @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)
  /// "MENSAL" (até o dia 5 do mês seguinte) | "FINAL" (fim da vigência)
  tipo                 String
  /// Mês de referência do relatório mensal ("2026-09"); vazio no final.
  competencia          String    @default("")
  versao               Int
  /// O que o aluno fez no período.
  descricao            String    @default("")
  /// "ENVIADO" | "APROVADO" | "DEVOLVIDO"
  status               String
  comentarioOrientador String?
  /// PDF: opcional no mensal, obrigatório para aprovar o final.
  storageKey           String?
  nome                 String?
  tamanho              Int?
  mimeType             String?
  enviadoEm            DateTime
  avaliadoEm           DateTime?

  @@unique([inscricaoId, tipo, competencia, versao])
}
