// Schema Prisma — mapeamento 1:1 do domínio em memória para PostgreSQL.
// O portal roda com repositórios in-memory (ver app.container.ts) até a Sprint de
// persistência; este schema é o contrato oficial para a migração via `prisma migrate`.
//
// Uso futuro:
//   npx prisma generate --schema src/infra/prisma/schema.prisma
//   npx prisma migrate dev --schema src/infra/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EditalStatus {
  RASCUNHO
  PUBLICADO
  ENCERRADO
}

enum BolsaTipo {
  PIBIC
  PIBITI
  PIBIC_AF
  VOLUNTARIO
}

enum NotificacaoTipo {
  EDITAL_PUBLICADO
  EDITAL_ENCERRADO
}

model Edital {
  id                    String       @id @default(uuid())
  numero                String       @unique
  titulo                String
  descricao             String       @default("")
  status                EditalStatus @default(RASCUNHO)
  tipoBolsa             BolsaTipo
  totalCotas            Int
  dataInicioInscricoes  DateTime
  dataFimInscricoes     DateTime
  publicadoEm           DateTime?
  encerradoEm           DateTime?
  criadoEm              DateTime     @default(now())
  atualizadoEm          DateTime     @updatedAt

  cotas                 CotaSubarea[]

  @@index([status, dataFimInscricoes])
}

model CotaSubarea {
  id          String  @id @default(uuid())
  editalId    String
  edital      Edital  @relation(fields: [editalId], references: [id], onDelete: Cascade)
  subareaCode String
  subareaNome String
  quantidade  Int

  @@unique([editalId, subareaCode])
  @@index([subareaCode])
}

model Notificacao {
  id          String          @id @default(uuid())
  userId      String
  tipo        NotificacaoTipo
  titulo      String
  mensagem    String
  referenceId String?
  lida        Boolean         @default(false)
  criadoEm    DateTime        @default(now())

  @@index([userId, lida])
  @@index([referenceId])
}
